RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/dbname?sslmode=require"
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"

# Optional: if set, all /api/a2a/* checkout & negotiate calls must carry
# `Authorization: Bearer <this value>`. Left unset by default so the demo
# stays open, but the enforcement code is live in src/lib/a2aSecurity.ts.
A2A_API_KEY=""

# Optional: enables real signature verification on incoming Razorpay
# webhooks (src/app/api/razorpay/webhook/route.ts). Get this from your
# Razorpay Dashboard -> Webhooks -> the webhook's configured secret.
RAZORPAY_WEBHOOK_SECRET=""
